# EchoState Web UI — Environment Configuration
# Copy this file to .env.local and adjust values as needed.

# Base URL of the EchoState API server.
# In Docker Compose, this is set to /api (relative path via reverse proxy).
# For local development, use the full URL:
NEXT_PUBLIC_API_URL=http://localhost:8080

# Public site origin for sitemap.xml, robots.txt, and Open Graph metadataBase.
# Set at build time in production (e.g. https://echostate.lazyapp.me).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
